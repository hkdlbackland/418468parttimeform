<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#F2F2F7">
<meta http-equiv="Cache-Control" content="no-cache,no-store,must-revalidate">
<title>Team Hub</title>
<style>
:root{
  --blue:#007AFF;--purple:#5856D6;--green:#34C759;--orange:#FF9500;
  --red:#FF3B30;--pink:#FF2D55;--teal:#5AC8FA;--yellow:#FFCC00;
  --bg:#F2F2F7;--card:#FFFFFF;--label:#1C1C1E;--sub:#8E8E93;
  --sep:rgba(60,60,67,.08);--fill:rgba(118,118,128,.12);
  --safe-t:env(safe-area-inset-top,0px);--safe-b:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none}
body{
  font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Helvetica Neue',system-ui,sans-serif;
  background:var(--bg);color:var(--label);overscroll-behavior:none;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
input,select,textarea{font-family:inherit;font-size:16px}
input:focus,select:focus,textarea:focus{outline:none}

@keyframes springIn{0%{opacity:0;transform:translateY(20px) scale(.97)}60%{transform:translateY(-2px) scale(1.005)}100%{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideSheet{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes checkPop{0%{transform:scale(0)}55%{transform:scale(1.18)}100%{transform:scale(1)}}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes toastIn{0%{opacity:0;transform:translateX(-50%) translateY(-16px) scale(.92)}55%{transform:translateX(-50%) translateY(2px) scale(1.01)}100%{opacity:1;transform:translateX(-50%) none}}
@keyframes toastOut{to{opacity:0;transform:translateX(-50%) translateY(-12px) scale(.92)}}
@keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}
@keyframes dotPop{0%{transform:scale(.3)}60%{transform:scale(1.15)}100%{transform:scale(1)}}
@keyframes glow{0%,100%{box-shadow:0 2px 16px rgba(0,122,255,.2)}50%{box-shadow:0 2px 24px rgba(0,122,255,.35)}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes pinBtnFlash{0%{background:rgba(0,122,255,.18)}100%{background:var(--fill)}}

.spring{animation:springIn .5s cubic-bezier(.25,.1,.25,1) both}
.fade{animation:fadeIn .25s ease both}

.scroll-hide::-webkit-scrollbar{width:0;height:0}.scroll-hide{scrollbar-width:none}
.glass{background:rgba(255,255,255,.72);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px)}
.glass-heavy{background:rgba(242,242,247,.82);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px)}
.hairline{border-bottom:.5px solid var(--sep)}
.sf-large{font-size:34px;font-weight:800;letter-spacing:-.5px;line-height:1.1}
.sf-title{font-size:17px;font-weight:700;letter-spacing:-.2px}
.sf-body{font-size:15px;font-weight:400;letter-spacing:-.1px}
.sf-caption{font-size:13px;font-weight:500;color:var(--sub)}
.sf-footnote{font-size:12px;color:var(--sub)}
.ios-card{background:var(--card);border-radius:16px;box-shadow:0 .5px 1px rgba(0,0,0,.04)}
.ios-btn{
  display:flex;align-items:center;justify-content:center;
  border:none;cursor:pointer;font-family:inherit;font-weight:600;
  transition:transform .15s cubic-bezier(.25,.1,.25,1),opacity .15s;
}
.ios-btn:active{transform:scale(.96);opacity:.7}

.marquee-wrap{overflow:hidden;white-space:nowrap}
.marquee-track{display:inline-flex;white-space:nowrap;will-change:transform}
.marquee-track.run{animation:marquee var(--dur,20s) linear infinite}

.ios-toast{
  position:fixed;top:calc(54px + var(--safe-t));left:50%;z-index:200;
  background:rgba(50,50,50,.88);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);
  color:#fff;font-size:14px;font-weight:600;letter-spacing:-.1px;
  padding:12px 22px;border-radius:14px;
  box-shadow:0 4px 20px rgba(0,0,0,.12);
  animation:toastIn .4s cubic-bezier(.25,.1,.25,1) both;
  pointer-events:none;
}

.sheet-bg{position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.18);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);animation:fadeIn .2s ease both}
.sheet{
  position:fixed;bottom:0;left:0;right:0;z-index:81;
  max-height:92vh;background:var(--bg);
  border-radius:16px 16px 0 0;
  overflow-y:auto;-webkit-overflow-scrolling:touch;
  animation:slideSheet .35s cubic-bezier(.25,.1,.25,1) both;
}
.sheet-handle{width:36px;height:5px;border-radius:3px;background:rgba(60,60,67,.2);margin:8px auto 0}
.sheet-nav{
  position:sticky;top:0;z-index:5;
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 20px 12px;
  background:rgba(242,242,247,.85);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);
  border-bottom:.5px solid var(--sep);
}
.sheet-nav .left,.sheet-nav .right{min-width:60px}
.sheet-nav .left{text-align:left}.sheet-nav .right{text-align:right}
.sheet-nav .center{font-size:15px;font-weight:700}
.sheet-link{font-size:15px;font-weight:600;color:var(--blue);background:none;border:none;cursor:pointer;font-family:inherit;padding:4px 0}
.sheet-link:active{opacity:.4}

.pin-btn{
  width:100%;aspect-ratio:1;border-radius:50%;border:none;
  background:var(--fill);font-size:28px;font-weight:400;color:var(--label);
  cursor:pointer;font-family:inherit;
  transition:background .1s,transform .1s;
}
.pin-btn:active,.pin-btn.kb-flash{background:rgba(0,122,255,.18);transform:scale(.9)}
.pin-btn.kb-flash{animation:pinBtnFlash .25s ease-out}

.card-tap{transition:transform .15s cubic-bezier(.25,.1,.25,1),box-shadow .15s}
.card-tap:active{transform:scale(.95)!important}
</style>
</head>
<body>
<div id="app"></div>
<script>
const API='https://script.google.com/macros/s/AKfycbwiRcNYAfGlzaQQ66B3LmRhR72m-b1HO3_Ogp_5fDRh8m2sKVyhzCs2lWpG7l0D7YHR_Q/exec';
const PIN_LEN=6;

const GRADS={
  blue:{bg:'linear-gradient(135deg,#007AFF,#5AC8FA)',shadow:'rgba(0,122,255,.25)',l:'系統藍'},
  purple:{bg:'linear-gradient(135deg,#5856D6,#AF52DE)',shadow:'rgba(88,86,214,.25)',l:'系統紫'},
  green:{bg:'linear-gradient(135deg,#34C759,#30D158)',shadow:'rgba(52,199,89,.25)',l:'系統綠'},
  orange:{bg:'linear-gradient(135deg,#FF9500,#FFCC00)',shadow:'rgba(255,149,0,.25)',l:'系統橙'},
  red:{bg:'linear-gradient(135deg,#FF3B30,#FF6259)',shadow:'rgba(255,59,48,.25)',l:'系統紅'},
  pink:{bg:'linear-gradient(135deg,#FF2D55,#FF6482)',shadow:'rgba(255,45,85,.25)',l:'系統粉'},
  teal:{bg:'linear-gradient(135deg,#5AC8FA,#70D7FF)',shadow:'rgba(90,200,250,.25)',l:'淺藍'},
  indigo:{bg:'linear-gradient(135deg,#5856D6,#7A78E8)',shadow:'rgba(88,86,214,.25)',l:'靛藍'},
  mint:{bg:'linear-gradient(135deg,#00C7BE,#66D4CF)',shadow:'rgba(0,199,190,.25)',l:'薄荷'},
  slate:{bg:'linear-gradient(135deg,#636366,#8E8E93)',shadow:'rgba(99,99,102,.25)',l:'石墨'}
};

const EMOJIS=['📝','📊','📋','📅','🧑‍💼','👤','💰','🎯','📸','⚙️','📆','🏆','📈','💡','🔧','📌','🎨','📱','💼','🗂️','📂','🔗','🏠','📮','🛒','🎫','📖','🔍','✅','🎬','📷','🖥️','🔔','💬','🗺️','🎉','⭐','🚀','🔥','🎪','🌸','🦋','☕','🧸','🎵','🌈','💜','🍰'];
const CATS=['表單','數據','工具','其他'];
const CAT_ICONS={表單:'📝',數據:'📊',工具:'🔧',其他:'📌'};
const NTYPES=[
  {key:'important',emoji:'📌',label:'重要',c:'#FF3B30'},
  {key:'reminder',emoji:'🔔',label:'提醒',c:'#FF9500'},
  {key:'info',emoji:'💡',label:'Tips',c:'#007AFF'}
];

const S={
  cards:[],notices:[],
  set:{title:'Team Hub',sub:'撳入去就用到 📱',pwd:''},
  loaded:false,loading:true,admin:false,view:'main',
  editModal:null,pwdModal:null,delConfirm:null,
  noticeEdit:null,noticeDel:null,toast:'',
  pinLogin:false,pinSet:false,
  _pin:'',_pinStep:1,_pinFirst:'',_pinErr:false,_pinBusy:false,_cPwd:''
};

const esc=s=>String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const today=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');};
function greeting(){const h=new Date().getHours();if(h<6)return'🌙 夜深了';if(h<12)return'☀️ 早安';if(h<18)return'🌤️ 午安';return'🌙 晚安';}
function validatePin(){if(S.set.pwd&&!/^\d{6}$/.test(S.set.pwd))S.set.pwd='';}
function cache(){try{localStorage.setItem('hubV6',JSON.stringify({cards:S.cards,notices:S.notices,set:S.set}));}catch(e){}}

async function load(){
  try{const c=localStorage.getItem('hubV6');if(c){const d=JSON.parse(c);S.cards=d.cards||[];S.notices=d.notices||[];S.set={...S.set,...d.set};validatePin();S.loaded=true;S.loading=false;render();}}catch(e){}
  if(API){try{const r=await fetch(API+'?action=getHubConfig');const j=await r.json();if(j.success&&j.data){S.cards=j.data.cards||[];S.notices=j.data.notices||[];S.set={...S.set,...j.data.set};validatePin();cache();}}catch(e){}}
  S.loaded=true;S.loading=false;render();
}

async function save(){
  cache();if(!API)return;
  try{await fetch(API,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify({action:'saveHubConfig',data:{cards:S.cards,notices:S.notices,set:S.set}})});}catch(e){}
}

function toast(m){S.toast=m;render();setTimeout(()=>{S.toast='';render();},2400);}

function syncForms(){
  if(S.editModal){
    ['eName','eDesc','eUrl','ePwd'].forEach(id=>{const el=document.getElementById(id);if(el)S.editModal[{eName:'name',eDesc:'desc',eUrl:'url',ePwd:'pwd'}[id]]=el.value;});
    const c=document.getElementById('eCat');if(c)S.editModal.cat=c.value;
  }
  if(S.noticeEdit){const t=document.getElementById('nText'),tp=document.getElementById('nType');if(t)S.noticeEdit.text=t.value;if(tp)S.noticeEdit.type=tp.value;}
}

/* ═══════════════════════════════════════════ */
/*  KEYBOARD SUPPORT FOR PIN PAD               */
/* ═══════════════════════════════════════════ */
function flashPinBtn(digit){
  const btn=document.querySelector(`.pin-btn[data-a="pinDigit"][data-d="${digit}"]`);
  if(!btn)return;
  btn.classList.remove('kb-flash');
  void btn.offsetWidth;
  btn.classList.add('kb-flash');
  setTimeout(()=>btn.classList.remove('kb-flash'),250);
}
function flashBackBtn(){
  const btn=document.querySelector('.pin-btn[data-a="pinBack"]');
  if(!btn)return;
  btn.classList.remove('kb-flash');
  void btn.offsetWidth;
  btn.classList.add('kb-flash');
  setTimeout(()=>btn.classList.remove('kb-flash'),250);
}

document.addEventListener('keydown',function(e){
  /* Only intercept when PIN modal is open */
  if(!S.pinLogin&&!S.pinSet)return;
  /* Prevent typing into hidden inputs etc */
  const tag=e.target.tagName;
  if(tag==='INPUT'||tag==='TEXTAREA'||tag==='SELECT')return;

  if(/^[0-9]$/.test(e.key)){
    e.preventDefault();
    flashPinBtn(e.key);
    act('pinDigit',{d:e.key});
  }else if(e.key==='Backspace'||e.key==='Delete'){
    e.preventDefault();
    flashBackBtn();
    act('pinBack');
  }else if(e.key==='Escape'){
    e.preventDefault();
    act('pinClose');
  }
});

function render(){
  syncForms();
  const fid=document.activeElement?.id||null;
  let ss=null,se=null;
  try{ss=document.activeElement?.selectionStart;se=document.activeElement?.selectionEnd;}catch(e){}
  document.getElementById('app').innerHTML=S.loading&&!S.loaded?loadingHTML():(S.view==='main'?mainHTML():settingsHTML())+(S.pinLogin||S.pinSet?pinHTML():'')+(S.editModal?editHTML():'')+(S.pwdModal?pwdHTML():'')+(S.delConfirm?delHTML():'')+(S.noticeEdit?noticeEditHTML():'')+(S.noticeDel?noticeDelHTML():'')+(S.toast?toastHTML():'');
  bind();initMarquee();
  if(fid){const el=document.getElementById(fid);if(el){el.focus();if(typeof ss==='number')try{el.setSelectionRange(ss,se);}catch(e){}}}
}

function initMarquee(){const t=document.querySelector('.marquee-track');if(!t)return;const n=S.notices.filter(n=>!n.hidden);if(!n.length)return;t.style.setProperty('--dur',Math.max(18,n.length*22)+'s');requestAnimationFrame(()=>t.classList.add('run'));}

/* ═══════════════════════════════════════════ */
/*  MAIN VIEW                                  */
/* ═══════════════════════════════════════════ */
function loadingHTML(){
  return`<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg)">
  <div style="text-align:center" class="spring"><div style="font-size:48px;margin-bottom:16px">📱</div>
  <div style="font-size:15px;font-weight:700;color:var(--blue)">載入緊...</div>
  <div style="margin:12px auto 0;width:120px;height:4px;border-radius:2px;background:var(--fill);overflow:hidden">
  <div style="width:55%;height:100%;border-radius:2px;background:linear-gradient(90deg,var(--blue),var(--teal));background-size:200% 100%;animation:shimmer 1.4s infinite"></div></div></div></div>`;
}

function mainHTML(){
  const g=greeting();
  let h=`<div style="min-height:100vh;background:var(--bg)">`;

  h+=`<div style="background:linear-gradient(160deg,#007AFF,#5856D6);position:relative;overflow:hidden">`;
  h+=`<div style="position:absolute;top:-30px;right:-20px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,.08)"></div>`;
  h+=`<div style="position:absolute;bottom:20px;left:-30px;width:100px;height:100px;border-radius:50%;background:rgba(90,200,250,.1)"></div>`;
  h+=`<div style="position:absolute;top:40px;right:40%;width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.2)"></div>`;
  h+=`<div style="position:relative;padding:60px 24px 48px">`;
  h+=`<div class="spring" style="display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,.15);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border-radius:20px;padding:5px 12px;margin-bottom:12px">
    <span style="font-size:12px;font-weight:600;color:rgba(255,255,255,.8)">${g}</span></div>`;
  h+=`<div class="sf-large spring" style="color:#fff;margin-bottom:4px;animation-delay:.04s">${esc(S.set.title)}</div>`;
  h+=`<div class="spring" style="font-size:15px;font-weight:500;color:rgba(255,255,255,.55);letter-spacing:-.1px;animation-delay:.08s">${esc(S.set.sub)}</div>`;
  h+=`</div>`;
  h+=`<svg style="display:block;margin-top:-1px" viewBox="0 0 1440 48" preserveAspectRatio="none"><path d="M0,20Q360,48,720,18T1440,26V48H0Z" fill="var(--bg)"/></svg>`;
  h+=`</div>`;

  const an=S.notices.filter(n=>!n.hidden);
  if(an.length){
    h+=`<div style="margin:-4px 16px 0;border-radius:14px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.04)" class="spring">`;
    h+=`<div style="background:var(--card);display:flex;align-items:center">`;
    h+=`<div style="padding:10px 14px;display:flex;align-items:center;gap:6px;border-right:.5px solid var(--sep);flex-shrink:0">`;
    h+=`<span style="font-size:13px">📢</span>`;
    h+=`<span style="font-size:11px;font-weight:700;color:var(--sub)">公告</span>`;
    h+=`<span style="width:5px;height:5px;border-radius:50%;background:var(--blue);animation:pulse 2s ease-in-out infinite"></span>`;
    h+=`</div>`;
    h+=`<div class="marquee-wrap" style="flex:1;padding:10px 14px 10px 10px"><div class="marquee-track">`;
    for(let r=0;r<2;r++){an.forEach(n=>{
      const nt=NTYPES.find(t=>t.key===n.type)||NTYPES[2];
      h+=`<span style="display:inline-flex;align-items:center;gap:8px;margin-right:40px">`;
      h+=`<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:${nt.c};background:${nt.c}12;padding:2px 7px;border-radius:5px">${nt.emoji} ${nt.label}</span>`;
      h+=`<span style="font-size:13px;font-weight:500;color:var(--label)">${esc(n.text)}</span>`;
      h+=`<span style="color:var(--sep);margin:0 4px">·</span></span>`;
    });}
    h+=`</div></div></div></div>`;
  }

  h+=`<div style="padding:20px 16px 120px;max-width:500px;margin:0 auto">`;
  const cats={};S.cards.forEach(c=>{const k=c.cat||'其他';if(!cats[k])cats[k]=[];cats[k].push(c);});
  const sorted=Object.keys(cats).sort((a,b)=>{const ia=CATS.indexOf(a),ib=CATS.indexOf(b);return(ia<0?99:ia)-(ib<0?99:ib);});

  if(!S.cards.length&&!an.length){
    h+=`<div style="text-align:center;padding:80px 20px" class="spring">
    <div style="font-size:56px;margin-bottom:14px">📂</div>
    <div style="font-size:17px;font-weight:700;color:var(--label);margin-bottom:6px">仲未有任何項目</div>
    <div style="font-size:13px;color:var(--sub);line-height:1.6">撳右下角 ⚙️ 開始設定啦～<br>加幾張卡片就可以用㗎喇</div></div>`;
  } else if(S.cards.length){
    sorted.forEach((cat,ci)=>{
      const icon=CAT_ICONS[cat]||'📌';
      h+=`<div class="spring" style="margin-bottom:24px;animation-delay:${ci*.06}s">`;
      h+=`<div style="display:flex;align-items:center;gap:6px;padding:0 4px;margin-bottom:10px">`;
      h+=`<span style="font-size:13px">${icon}</span>`;
      h+=`<span style="font-size:13px;font-weight:700;color:var(--sub);text-transform:uppercase;letter-spacing:.5px">${cat}</span>`;
      h+=`<span style="font-size:11px;font-weight:700;color:var(--blue);background:rgba(0,122,255,.08);padding:2px 8px;border-radius:6px">${cats[cat].length}</span>`;
      h+=`</div>`;
      h+=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">`;
      cats[cat].forEach((c,i)=>{
        const gr=GRADS[c.color]||GRADS.blue;
        h+=`<div class="card-tap spring" style="border-radius:16px;padding:16px;cursor:pointer;position:relative;overflow:hidden;background:${gr.bg};box-shadow:0 4px 16px ${gr.shadow};min-height:110px;animation-delay:${(ci*.06)+(i+1)*.04}s" data-a="open" data-id="${c.id}">`;
        h+=`<div style="position:absolute;top:0;right:0;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,.1);transform:translate(20px,-20px)"></div>`;
        h+=`<div style="position:absolute;bottom:0;left:0;width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.05);transform:translate(-15px,15px)"></div>`;
        if(c.pwd)h+=`<div style="position:absolute;top:10px;right:10px;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:10px;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)">🔒</div>`;
        h+=`<div style="position:relative;z-index:1"><div style="font-size:28px;margin-bottom:8px">${c.icon||'📱'}</div>`;
        h+=`<div style="font-size:14px;font-weight:700;color:#fff;letter-spacing:-.1px">${esc(c.name)}</div>`;
        if(c.desc)h+=`<div style="font-size:11px;color:rgba(255,255,255,.55);margin-top:3px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.4;font-weight:500">${esc(c.desc)}</div>`;
        h+=`</div></div>`;
      });
      h+=`</div></div>`;
    });
  }
  h+=`</div>`;

  h+=`<button data-a="admin" class="ios-btn" style="position:fixed;bottom:28px;right:20px;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#007AFF,#5856D6);color:#fff;font-size:20px;box-shadow:0 4px 16px rgba(0,122,255,.3);z-index:30;animation:glow 2.5s ease-in-out infinite">⚙️</button>`;

  h+=`</div>`;
  return h;
}

/* ═══════════════════════════════════════════ */
/*  SETTINGS VIEW                              */
/* ═══════════════════════════════════════════ */
function settingsHTML(){
  let h=`<div style="min-height:100vh;background:var(--bg)">`;

