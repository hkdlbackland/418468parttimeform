function pinHTML(){
  const isLogin=S.pinLogin;
  let title,sub;
  if(isLogin){title='管理員登入';sub='輸入 6 位數 PIN';}
  else if(S._pinStep===1){title='設定新 PIN';sub='請輸入 6 位數字';}
  else{title='確認 PIN';sub='再輸入一次確認';}

  let dots='';
  for(let i=0;i<PIN_LEN;i++){
    const filled=i<S._pin.length;
    const latest=filled&&i===S._pin.length-1;
    let st='width:14px;height:14px;border-radius:50%;transition:all .15s;';
    if(S._pinErr)st+='background:#FF3B30;';
    else if(filled)st+=`background:var(--blue);${latest?'animation:dotPop .2s cubic-bezier(.25,.1,.25,1);':''}`;
    else st+='border:2px solid #D1D1D6;';
    dots+=`<div style="${st}"></div>`;
  }

  let h=`<div class="sheet-bg"></div>`;
  h+=`<div class="sheet" style="max-height:auto;padding-bottom:calc(20px + var(--safe-b));${S._pinErr?'animation:shake .4s ease;':''}">`;
  h+=`<div class="sheet-handle"></div>`;
  h+=`<div class="sheet-nav"><div class="left"></div><div class="center">${title}</div><div class="right"><button data-a="pinClose" class="sheet-link">取消</button></div></div>`;

  h+=`<div style="text-align:center;padding:24px 20px 8px">`;
  h+=`<div style="font-size:44px;margin-bottom:12px">${isLogin?'🔐':'🔑'}</div>`;
  h+=`<div style="font-size:13px;color:var(--sub);margin-bottom:20px">${sub}</div>`;
  h+=`<div style="display:flex;justify-content:center;gap:14px;margin-bottom:8px">${dots}</div>`;
  if(S._pinErr)h+=`<div style="color:var(--red);font-size:13px;font-weight:600;margin-top:8px">${isLogin?'PIN 錯誤':'兩次唔一樣，重新嚟過'}</div>`;
  /* Keyboard hint for PC users */
  h+=`<div style="font-size:11px;color:var(--sub);margin-top:12px;opacity:.6">⌨️ 可直接用鍵盤輸入數字</div>`;
  h+=`</div>`;

  h+=`<div style="padding:20px 48px 24px;max-width:340px;margin:0 auto">`;
  h+=`<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px">`;
  for(let n=1;n<=9;n++)h+=`<button data-a="pinDigit" data-d="${n}" class="pin-btn">${n}</button>`;
  h+=`<div></div>`;
  h+=`<button data-a="pinDigit" data-d="0" class="pin-btn">0</button>`;
  h+=`<button data-a="pinBack" class="pin-btn" style="font-size:20px;color:var(--sub)">⌫</button>`;
  h+=`</div></div></div>`;
  return h;
}

