      if(i>0)h+=`<button data-a="move" data-id="${c.id}" data-d="up" class="ios-btn" style="width:28px;height:28px;border-radius:7px;font-size:11px;background:var(--fill);color:var(--sub)">▲</button>`;else h+=`<div style="width:28px"></div>`;
