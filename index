  h+=`<div style="padding:8px 16px 32px;display:flex;flex-direction:column;gap:8px">`;
  h+=`<button data-a="confirmNDel" class="ios-btn" style="width:100%;padding:16px;border-radius:14px;font-size:16px;font-weight:600;color:#fff;background:var(--red)">刪除</button>`;
  h+=`<button data-a="cancelNDel" class="ios-btn" style="width:100%;padding:16px;border-radius:14px;font-size:16px;font-weight:600;color:var(--blue);background:var(--fill)">取消</button>`;
  h+=`</div></div>`;
  return h;
}

function toastHTML(){
  return`<div class="ios-toast">${S.toast}</div>`;
}

/* ═══════════════════════════════════════════ */
/*  EVENT BINDING                              */
/* ═══════════════════════════════════════════ */
function bind(){
  document.querySelectorAll('[data-a]').forEach(el=>{
    const a=el.dataset.a;
    el.onclick=function(ev){
      if(el._th){el._th=false;return;}
      if(['closeEdit','closeN','closePwd','cancelDel','cancelNDel'].includes(a)&&ev.target!==this)return;
      act(a,this.dataset);
    };
    el.addEventListener('touchend',function(ev){
      if(['checkPwd','saveCard','saveN','saveSet','pinDigit','pinBack','pinClose'].includes(a)){ev.preventDefault();el._th=true;act(a,el.dataset);}
    });
  });
  const cp=document.getElementById('cPwd');
  if(cp){cp.onkeydown=e=>{if(e.key==='Enter')act('checkPwd');};setTimeout(()=>cp.focus(),120);}
}

/* ═══════════════════════════════════════════ */
/*  ACTIONS                                    */
/* ═══════════════════════════════════════════ */
function act(a,d={}){
  switch(a){
  case'open':{const c=S.cards.find(x=>x.id===d.id);if(!c)return;if(c.pwd){S._cPwd='';S.pwdModal={card:c,err:false};render();}else{c.url?window.open(c.url,'_blank'):toast('⚠️ 未設定連結');}break;}
  case'checkPwd':{const inp=document.getElementById('cPwd');if(inp&&inp.value===S.pwdModal.card.pwd){const u=S.pwdModal.card.url;S._cPwd='';S.pwdModal=null;render();u?window.open(u,'_blank'):toast('⚠️ 未設定連結');}else{S.pwdModal.err=true;render();}break;}
  case'closePwd':S._cPwd='';S.pwdModal=null;render();break;

  case'admin':{if(S.set.pwd&&!S.admin){S._pin='';S._pinErr=false;S._pinBusy=false;S.pinLogin=true;render();}else{S.admin=true;S.view='settings';render();}break;}

  case'pinDigit':{
    if(S._pinBusy||S._pin.length>=PIN_LEN)return;
    S._pin+=d.d;S._pinErr=false;render();
    if(S._pin.length===PIN_LEN){
      S._pinBusy=true;
      setTimeout(()=>{
        if(S.pinLogin){
          if(S._pin===S.set.pwd){S._pin='';S.pinLogin=false;S._pinBusy=false;S.admin=true;S.view='settings';render();}
          else{S._pinErr=true;render();setTimeout(()=>{S._pin='';S._pinErr=false;S._pinBusy=false;render();},700);}
        }else if(S.pinSet){
          if(S._pinStep===1){S._pinFirst=S._pin;S._pin='';S._pinStep=2;S._pinBusy=false;render();}
          else{
            if(S._pin===S._pinFirst){S.set.pwd=S._pin;S._pin='';S._pinFirst='';S._pinStep=1;S.pinSet=false;S._pinBusy=false;save();toast('✅ PIN 已設定');}
            else{S._pinErr=true;render();setTimeout(()=>{S._pin='';S._pinErr=false;S._pinStep=1;S._pinFirst='';S._pinBusy=false;render();},800);}
          }
        }
      },280);
    }
    break;
  }
  case'pinBack':if(!S._pinBusy&&S._pin.length>0){S._pin=S._pin.slice(0,-1);S._pinErr=false;render();}break;
  case'pinClose':S._pin='';S._pinStep=1;S._pinFirst='';S._pinErr=false;S._pinBusy=false;S.pinLogin=false;S.pinSet=false;render();break;
  case'startPinSet':S._pin='';S._pinStep=1;S._pinFirst='';S._pinErr=false;S._pinBusy=false;S.pinSet=true;render();break;
  case'clearPin':S.set.pwd='';save();toast('🔓 PIN 已清除');break;

  case'back':S.view='main';S.admin=false;render();break;

  case'saveSet':{S.set.title=document.getElementById('hTitle').value.trim()||'Team Hub';S.set.sub=document.getElementById('hSub').value.trim();save();toast('✅ 設定已儲存');break;}

  case'add':S.editModal={id:'',icon:'📝',name:'',desc:'',url:'',pwd:'',cat:'其他',color:'blue'};render();break;
  case'edit':{const c=S.cards.find(x=>x.id===d.id);if(c)S.editModal={...c};render();break;}
  case'del':{const c=S.cards.find(x=>x.id===d.id);if(c)S.delConfirm={id:c.id,name:c.name,icon:c.icon};render();break;}
  case'confirmDel':if(S.delConfirm){S.cards=S.cards.filter(c=>c.id!==S.delConfirm.id);S.delConfirm=null;save();toast('🗑️ 已刪除');}break;
  case'cancelDel':S.delConfirm=null;render();break;
  case'move':{const i=S.cards.findIndex(c=>c.id===d.id);if(i<0)return;if(d.d==='up'&&i>0)[S.cards[i],S.cards[i-1]]=[S.cards[i-1],S.cards[i]];if(d.d==='down'&&i<S.cards.length-1)[S.cards[i],S.cards[i+1]]=[S.cards[i+1],S.cards[i]];save();render();break;}
  case'emoji':if(S.editModal){S.editModal.icon=d.e;render();}break;
  case'color':if(S.editModal){S.editModal.color=d.c;render();}break;
  case'saveCard':{
    const n=document.getElementById('eName').value.trim();
    const ds=document.getElementById('eDesc').value.trim();
    const u=document.getElementById('eUrl').value.trim();
    const ct=document.getElementById('eCat').value;
    const pw=document.getElementById('ePwd').value;
    if(!n){toast('⚠️ 請輸入名稱');return;}
    const cd={...S.editModal,name:n,desc:ds,url:u,cat:ct,pwd:pw};
    if(cd.id){S.cards=S.cards.map(c=>c.id===cd.id?cd:c);}else{cd.id=Date.now().toString();S.cards.push(cd);}
    S.editModal=null;save();toast('✅ 已儲存');break;
  }
  case'closeEdit':S.editModal=null;render();break;

  case'addN':S.noticeEdit={id:'',text:'',type:'important',date:today()};render();break;
  case'editN':{const n=S.notices.find(x=>x.id===d.id);if(n)S.noticeEdit={...n};render();break;}
  case'saveN':{
    const tx=document.getElementById('nText').value.trim();const tp=document.getElementById('nType').value;
    if(!tx){toast('⚠️ 請輸入內容');return;}
    const nd={...S.noticeEdit,text:tx,type:tp};
    if(nd.id){S.notices=S.notices.map(n=>n.id===nd.id?{...n,text:nd.text,type:nd.type}:n);}
    else{nd.id='n'+Date.now();nd.date=today();S.notices.unshift(nd);}
    S.noticeEdit=null;save();toast('✅ 公告已儲存');break;
  }
  case'closeN':S.noticeEdit=null;render();break;
  case'toggleN':S.notices=S.notices.map(n=>n.id===d.id?{...n,hidden:!n.hidden}:n);save();render();break;
  case'delN':{const n=S.notices.find(x=>x.id===d.id);if(n)S.noticeDel=n;render();break;}
  case'confirmNDel':if(S.noticeDel){S.notices=S.notices.filter(n=>n.id!==S.noticeDel.id);S.noticeDel=null;save();toast('🗑️ 公告已刪除');}break;
  case'cancelNDel':S.noticeDel=null;render();break;
  }
}

load();
</script>
