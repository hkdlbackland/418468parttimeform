}

function iosField(label,id,val,ph){
  return`<div style="display:flex;align-items:center;padding:12px 16px">
    <span style="font-size:15px;font-weight:400;color:var(--label);width:72px;flex-shrink:0">${label}</span>
    <input id="${id}" value="${esc(val||'')}" placeholder="${ph}" style="flex:1;border:none;background:transparent;font-size:15px;color:var(--label);text-align:right;padding:0">
  </div>`;
}

