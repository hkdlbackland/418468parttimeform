    S.cards.forEach((c,i)=>{
      const gr=GRADS[c.color]||GRADS.blue;
      if(i>0)h+=`<div style="margin-left:56px" class="hairline"></div>`;
      h+=`<div style="display:flex;align-items:center;gap:12px;padding:12px 16px">`;
